{
	"extends": [
		"config:recommended",
		":preserveSemverRanges",
		"group:allNonMajor",
		":semanticCommitTypeAll(chore)"
	],
	"pin": {
		"enabled": false
	},
	"ignoreDeps": [
		"@types/node"
	],
	"packageRules": [
		{
			"matchDatasources": [
				"npm"
			],
			"minimumReleaseAge": "2 days"
		},
		{
			"matchPackageNames": [
				"@sveltejs/**",
				"svelte",
				"esrap",
				"devalue",
				"dts-buddy",
				"zimmerframe",
				"prettier-plugin-svelte",
				"svelte-check",
				"esm-env"
			],
			"minimumReleaseAge": "0 days"
		},
		{
			"matchPackageNames": [
				"vite"
			],
			"matchUpdateTypes": [
				"major"
			],
			"enabled": false
		}
	]
}
