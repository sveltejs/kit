{
	"name": "@sveltejs/adapter-vercel",
	"version": "7.0.0-next.9",
	"description": "A SvelteKit adapter that creates a Vercel app",
	"keywords": [
		"adapter",
		"deploy",
		"hosting",
		"svelte",
		"sveltekit",
		"vercel"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/adapter-vercel"
	},
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit/adapter-vercel",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"files",
		"index.js",
		"utils.js",
		"index.d.ts"
	],
	"scripts": {
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"check": "tsc",
		"test:unit": "vitest run *.spec.js",
		"test": "pnpm test:unit && pnpm -r --filter='./test/apps/**' test:build"
	},
	"dependencies": {
		"@vercel/nft": "^1.10.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "workspace:^",
		"@types/node": "catalog:",
		"typescript": "catalog:typescript-native",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0"
	}
}
