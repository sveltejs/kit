{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "es2022",
		"module": "node16",
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"paths": {
			"@sveltejs/kit": ["../kit/types/index"]
		},
		"types": ["bun-types", "node"]
	},
	"include": [
		"index.js",
		"vitest.config.js",
		"src/**/*.js",
		"test/*.js",
		"test/*.ts",
		"tests/**/*.js",
		"tests/**/*.ts",
		"./internal.d.ts"
	]
}
