{
	"name": "test-cloudflare-workers",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node test/validate.js && wrangler deploy --dry-run --outdir .svelte-kit/dry-run",
		"preview": "wrangler dev --port 8787",
		"generate:types": "wrangler types --config config/wrangler.jsonc",
		"test:dev": "DEV=true playwright test",
		"test:build": "playwright test",
		"test:base": "TEST_BASE=true playwright test",
		"test": "pnpm test:dev && pnpm test:build && pnpm test:base"
	},
	"devDependencies": {
		"@opentelemetry/api": "catalog:",
		"@sveltejs/adapter-cloudflare": "workspace:*",
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"cjs-dep": "file:cjs-dep",
		"conditions-dep": "file:conditions-dep",
		"server-side-dep": "file:server-side-dep",
		"svelte": "catalog:",
		"vite": "catalog:",
		"wrangler": "catalog:"
	},
	"type": "module"
}
