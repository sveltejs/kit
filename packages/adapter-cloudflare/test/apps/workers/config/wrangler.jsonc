// we've moved the wrangler config away from the root of the project
// to test that the adapter still resolves the paths correctly
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"main": "../dist/index.js",
	"compatibility_date": "2026-06-24",
	"assets": {
		"directory": "../dist/public",
		"binding": "ASSETS"
	},
	"vars": {
		"FOO": "from wrangler.jsonc"
	},
	// TODO: remove this after we bump wrangler since it enables it by default for later compat dates
	"compatibility_flags": ["nodejs_compat"]
}
