{
	"name": "@sveltejs/adapter-cloudflare",
	"version": "8.0.1",
	"description": "Adapts SvelteKit applications for Cloudflare Workers",
	"keywords": [
		"adapter",
		"cloudflare workers",
		"deploy",
		"hosting",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/adapter-cloudflare"
	},
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit/adapter-cloudflare",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"src/virtual-cloudflare-workers.js",
		"files/worker.js",
		"index.js",
		"utils.js",
		"config.js",
		"index.d.ts"
	],
	"scripts": {
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"check": "pnpm tsc-native && pnpm tsc-native --project files/tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"tsc-native": "node node_modules/@typescript/native/bin/tsc"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@rolldown/pluginutils": "^1.0.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260925.1",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "workspace:^",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0",
		"wrangler": "^4.153.0"
	}
}
