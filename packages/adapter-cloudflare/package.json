{
	"name": "@sveltejs/adapter-cloudflare",
	"version": "8.0.0-next.6",
	"description": "Adapts SvelteKit applications for Cloudflare Workers or Cloudflare Pages",
	"keywords": [
		"adapter",
		"cloudflare pages",
		"deploy",
		"hosting",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/adapter-cloudflare"
	},
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit/adapter-cloudflare",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"src/virtual-cloudflare-workers.js",
		"files/worker.js",
		"index.js",
		"utils.js",
		"index.d.ts"
	],
	"scripts": {
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"check": "tsc && tsc --project files/tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test",
		"test": "pnpm test:unit && pnpm test:e2e"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^5.20260809.1"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@rolldown/pluginutils": "^1.0.1",
		"@sveltejs/kit": "workspace:^",
		"@types/node": "catalog:",
		"typescript": "catalog:typescript-native",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0",
		"wrangler": "^4.118.0"
	}
}
