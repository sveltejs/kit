{
	"name": "@sveltejs/adapter-netlify",
	"version": "7.0.0-next.10",
	"description": "A SvelteKit adapter that creates a Netlify app",
	"keywords": [
		"adapter",
		"deploy",
		"hosting",
		"netlify",
		"svelte",
		"sveltekit"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/adapter-netlify"
	},
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit/adapter-netlify",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"files/*.js",
		"index.js",
		"utils.js",
		"index.d.ts",
		"ambient.d.ts"
	],
	"scripts": {
		"check": "tsc && tsc --project files/tsconfig.json",
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"test:unit": "vitest run",
		"test:build": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" build",
		"test": "pnpm test:unit && pnpm test:build"
	},
	"dependencies": {
		"@netlify/types": "^2.8.0",
		"rolldown": "^1.2.3",
		"smol-toml": "^1.8.0"
	},
	"devDependencies": {
		"@netlify/edge-functions": "^3.0.8",
		"@sveltejs/kit": "workspace:^",
		"@types/deno": "^2.7.0",
		"@types/node": "catalog:",
		"typescript": "catalog:typescript-native",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0"
	}
}
