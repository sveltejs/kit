{
	"name": "prerendering-test-basics",
	"private": true,
	"version": "0.0.2-next.0",
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf ./missing_ids && mkdir ./missing_ids && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && node node_modules/@typescript/native/bin/tsc && rsvelte-check --tsgo --tsconfig tsconfig.json",
		"test": "pnpm test:build",
		"test:build": "svelte-kit sync && vitest run",
		"test:cross-platform": "pnpm test"
	},
	"devDependencies": {
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"@rsvelte/svelte-check": "catalog:",
		"typescript": "catalog:",
		"@typescript/native": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"type": "module"
}
