{
	"name": "test-options",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"sync": "svelte-kit sync -c vite.custom.config.js",
		"dev": "pnpm sync && vite dev -c vite.custom.config.js",
		"build": "vite build -c vite.custom.config.js --mode custom",
		"preview": "vite preview -c vite.custom.config.js",
		"check": "pnpm sync && node node_modules/@typescript/native/bin/tsc && svelte-check --tsgo --incremental --config vite.custom.config.js",
		"test": "pnpm test:dev && pnpm test:build",
		"test:vitest": "pnpm sync && vitest run --config vite.custom.config.js",
		"test:paths-relative:dev": "DEV=true playwright test",
		"test:paths-assets:dev": "DEV=true PATHS_ASSETS=https://cdn.example.com/stuff playwright test",
		"test:dev": "pnpm test:vitest && pnpm test:paths-relative:dev && pnpm test:paths-assets:dev",
		"test:paths-relative:build": "playwright test",
		"test:paths-absolute:build": "PATHS_RELATIVE=false playwright test",
		"test:paths-assets:build": "PATHS_ASSETS=https://cdn.example.com/stuff playwright test",
		"test:build": "pnpm test:paths-relative:build && pnpm test:paths-absolute:build && pnpm test:paths-assets:build",
		"test:server-side-route-resolution:dev": "rm -rf test/errors.json && DEV=true ROUTER_RESOLUTION=server playwright test",
		"test:server-side-route-resolution:build": "rm -rf test/errors.json && ROUTER_RESOLUTION=server playwright test"
	},
	"devDependencies": {
		"@fontsource/libre-barcode-128-text": "catalog:",
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"@typescript/native": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"imports": {
		"#lib/*": "./source/components/*"
	},
	"type": "module"
}
