{
	"name": "test-options",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"sync": "svelte-kit sync -c vite.custom.config.js",
		"dev": "pnpm sync && vite dev -c vite.custom.config.js",
		"build": "vite build -c vite.custom.config.js --mode custom",
		"preview": "vite preview -c vite.custom.config.js",
		"check": "pnpm sync && node node_modules/@typescript/native/bin/tsc && svelte-check --tsgo --incremental --config vite.custom.config.js",
		"test": "pnpm test:dev && pnpm test:build",
		"test:vitest": "pnpm sync && vitest run --config vite.custom.config.js",
		"test:dev": "pnpm test:vitest && pnpm pw:dev && KIT_E2E_VARIANT=paths-assets pnpm pw:dev",
		"test:build": "pnpm pw:build && KIT_E2E_VARIANT=paths-absolute pnpm pw:build && KIT_E2E_VARIANT=paths-assets pnpm pw:build",
		"pw:dev": "DEV=true playwright test",
		"pw:build": "playwright test"
	},
	"devDependencies": {
		"@fontsource/libre-barcode-128-text": "catalog:",
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"@typescript/native": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"imports": {
		"#lib/*": "./source/components/*"
	},
	"type": "module"
}
