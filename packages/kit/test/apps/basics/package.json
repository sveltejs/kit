{
	"name": "test-basics",
	"private": true,
	"version": "0.0.2-next.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && node node_modules/@typescript/native/bin/tsc && svelte-check --tsgo --incremental",
		"test": "pnpm test:dev && pnpm test:build",
		"test:dev": "pnpm pw:dev && pnpm server:dev",
		"test:build": "pnpm pw:build && pnpm server:build",
		"pw:dev": "node test/playwright/setup.js && DEV=true playwright test test/playwright",
		"pw:build": "node test/playwright/setup.js && playwright test test/playwright",
		"server:dev": "node test/playwright/setup.js && KIT_TEST_DEV=true vitest run -c vitest.server.config.js",
		"server:build": "node test/playwright/setup.js && pnpm build && vitest run -c vitest.server.config.js",
		"test:cross-platform:dev": "pnpm test:client-import && node test/playwright/setup.js && DEV=true playwright test test/playwright/cross-platform/",
		"test:cross-platform:build": "node test/playwright/setup.js && playwright test test/playwright/cross-platform/",
		"test:client-import": "svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/sdk-node": "catalog:",
		"@opentelemetry/sdk-trace-node": "catalog:",
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"jsdom": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"test-redirect-importer": "workspace:*",
		"typescript": "catalog:",
		"@typescript/native": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"type": "module"
}
