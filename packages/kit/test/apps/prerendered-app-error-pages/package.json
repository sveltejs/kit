{
	"name": "test-prerendered-app-error-pages",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && pnpm tsc-native && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && pnpm tsc-native && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "pnpm test:dev && pnpm test:build",
		"test:dev": "DEV=true playwright test",
		"test:build": "playwright test",
		"tsc-native": "node node_modules/@typescript/native/bin/tsc"
	},
	"devDependencies": {
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"@typescript/native": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
