{
	"name": "@sveltejs/package",
	"version": "3.0.0-next.6",
	"description": "The fastest way to build Svelte packages",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/kit.git",
		"directory": "packages/package"
	},
	"keywords": [
		"build",
		"bundle",
		"component",
		"library",
		"packaging",
		"svelte",
		"tool"
	],
	"license": "MIT",
	"homepage": "https://svelte.dev",
	"type": "module",
	"dependencies": {
		"chokidar": "^5.0.0",
		"semver": "^7.8.5",
		"svelte2tsx": "~0.7.60"
	},
	"devDependencies": {
		"@sveltejs/kit": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@types/semver": "catalog:",
		"@typescript/native": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-preprocess": "catalog:",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^3.44.0 || ^4.0.0 || ^5.0.0-next.1",
		"typescript": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"bin": {
		"svelte-package": "svelte-package.js"
	},
	"files": [
		"src"
	],
	"scripts": {
		"lint": "oxfmt --check .",
		"check": "pnpm tsc-native",
		"check:all": "pnpm tsc-native && pnpm -r --filter=\"./**\" check",
		"format": "oxfmt --write .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"tsc-native": "node node_modules/@typescript/native/bin/tsc"
	},
	"exports": {
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	}
}
