{
	"name": "kit-monorepo",
	"version": "0.0.1",
	"description": "monorepo for @sveltejs/kit and friends",
	"private": true,
	"type": "module",
	"scripts": {
		"test:kit": "pnpm run --dir packages/kit test",
		"test:kit:unit": "vitest run packages/kit",
		"test:kit:dev": "pnpm run --dir packages/kit test:dev",
		"test:kit:build": "pnpm run --dir packages/kit test:build",
		"test:cross-platform:dev": "pnpm run --dir packages/kit test:cross-platform:dev",
		"test:cross-platform:build": "pnpm run --dir packages/kit test:cross-platform:build",
		"test:server-side-route-resolution:dev": "pnpm run --dir packages/kit test:server-side-route-resolution:dev",
		"test:server-side-route-resolution:build": "pnpm run --dir packages/kit test:server-side-route-resolution:build",
		"test:svelte-async:dev": "pnpm run --dir packages/kit test:svelte-async:dev",
		"test:svelte-async:build": "pnpm run --dir packages/kit test:svelte-async:build",
		"test:vite-ecosystem-ci": "pnpm --dir packages/kit test",
		"test:others": "pnpm -r --filter='./packages/*' --filter=!./packages/kit/ --workspace-concurrency=1 test",
		"test:others:unit": "pnpm -r --filter=\"./packages/*\" --filter=\"!./packages/kit\" --workspace-concurrency=1 test:unit",
		"test:unit": "vitest run",
		"check": "pnpm --filter='./packages/**' prepublishOnly && pnpm --filter='./packages/**' --filter='!./packages/kit/test/build-errors/**' check",
		"lint": "oxfmt --check . && echo '\nRunning oxlint...\n' && oxlint packages --deny-warnings",
		"format": "oxfmt --write .",
		"precommit": "pnpm format && pnpm lint",
		"changeset:version": "changeset version && pnpm -r generate:version && git add --all",
		"changeset:release": "changeset publish",
		"build": "pnpm --filter '@sveltejs/*' -r build",
		"sync-all": "node scripts/sync-all.js"
	},
	"devDependencies": {
		"@changesets/changelog-github": "catalog:",
		"@changesets/cli": "catalog:",
		"@playwright/test": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-n": "^18.2.2",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
	"engines": {
		"pnpm": ">=11.0.0"
	}
}
